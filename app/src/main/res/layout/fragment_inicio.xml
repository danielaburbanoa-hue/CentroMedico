<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_general">

    <!-- Banner de bienvenida -->
    <com.google.android.material.card.MaterialCardView
        style="@style/CardLab03"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/verde_primario_oscuro">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clínica San Rafael"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvFechaHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/verde_menta_claro"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Fila de contadores: Pacientes | Citas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp">

        <!-- Contador Pacientes -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardLab03"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    android:background="@drawable/circle_green_light_background"
                    android:padding="8dp"
                    app:tint="@color/verde_primario_oscuro"
                    android:contentDescription="Pacientes" />

                <TextView
                    android:id="@+id/tvContadorPacientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_primario_oscuro"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pacientes"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:alpha="0.6" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Contador Citas hoy -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardLab03"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:background="@drawable/circle_green_background"
                    android:padding="8dp"
                    app:tint="@color/white"
                    android:contentDescription="Citas" />

                <TextView
                    android:id="@+id/tvContadorCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_primario_oscuro"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Citas hoy"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:alpha="0.6" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Título sección citas del día -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Citas de Hoy"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/verde_primario_oscuro"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Lista de citas del día con doctor asignado -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCitasHoy"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>