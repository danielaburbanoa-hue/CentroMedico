<?xml version="1.0" encoding="utf-8"?>
<!-- Item de paciente para fragment_pacientes -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPaciente"
    style="@style/CardLab03"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila superior: avatar + nombre + ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Avatar con iniciales -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_green_background">

                <TextView
                    android:id="@+id/tvInicialesPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="CM"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvNombrePaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carlos Mendez"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tvDniPaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DNI: 12345678"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:alpha="0.6"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvEdadPaciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="34 años"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:alpha="0.6" />

        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/verde_menta_claro"
            android:layout_marginBottom="10dp" />

        <!-- Fila inferior: tratamiento + doctor asignado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRATAMIENTO"
                    android:textSize="10sp"
                    android:textColor="@color/black"
                    android:alpha="0.5"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvTratamientoPaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hipertensión arterial"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOCTOR ASIGNADO"
                    android:textSize="10sp"
                    android:textColor="@color/black"
                    android:alpha="0.5"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvDoctorPaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Elena Sánchez"
                    android:textSize="13sp"
                    android:textColor="@color/verde_primario_oscuro"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>