<?xml version="1.0" encoding="utf-8"?>
<!-- Item de cita completa para fragment_citas -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCita"
    style="@style/CardLab03"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila superior: hora + estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvHoraCitaCompleta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/verde_primario_oscuro"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvEstadoCitaCompleta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmada"
                android:textSize="11sp"
                android:textColor="@color/verde_primario_oscuro"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <!-- Fila: paciente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/black"
                android:alpha="0.5"
                android:contentDescription="Paciente" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente:"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:alpha="0.5"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvPacienteCita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carlos Mendez"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

        </LinearLayout>

        <!-- Fila: doctor asignado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                app:tint="@color/verde_primario_oscuro"
                android:contentDescription="Doctor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor:"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:alpha="0.5"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvDoctorAsignado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Elena Sánchez"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/verde_primario_oscuro" />

        </LinearLayout>

        <!-- Fila: especialidad + motivo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESPECIALIDAD"
                    android:textSize="10sp"
                    android:textColor="@color/black"
                    android:alpha="0.5"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvEspecialidadCita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardiología"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOTIVO"
                    android:textSize="10sp"
                    android:textColor="@color/black"
                    android:alpha="0.5"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvMotivoCitaCompleta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Control mensual"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>