<?xml version="1.0" encoding="utf-8"?>
<!-- Item de cita resumida en el fragment Inicio -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCitaResumen"
    style="@style/CardLab03"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Hora de la cita -->
        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/circle_green_light_background"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvHoraCita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/verde_primario_oscuro"
                android:gravity="center" />

        </LinearLayout>

        <!-- Info paciente + doctor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvNombrePacienteCita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carlos Mendez"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    app:tint="@color/verde_primario_oscuro"
                    android:contentDescription="Doctor" />

                <TextView
                    android:id="@+id/tvDoctorCita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Elena Sánchez"
                    android:textSize="12sp"
                    android:textColor="@color/verde_primario_oscuro"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvMotivoCita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consulta general"
                android:textSize="11sp"
                android:textColor="@color/black"
                android:alpha="0.6"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Badge estado -->
        <TextView
            android:id="@+id/tvEstadoCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pendiente"
            android:textSize="10sp"
            android:textColor="@color/verde_primario_oscuro"
            android:background="@drawable/badge_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>