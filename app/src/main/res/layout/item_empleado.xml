<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEmpleado"
    style="@style/CardLab03"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Avatar circular con iniciales -->
        <FrameLayout
            android:id="@+id/avatarFrame"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_green_background">

            <TextView
                android:id="@+id/tvInicialesAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="MJ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

        </FrameLayout>

        <!-- Información del empleado -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvNombreEmpleado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="María González"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvCargoEmpleado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Médica"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:alpha="0.7"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvEspecialidadTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardiología"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario_oscuro"
                    android:background="@drawable/badge_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ID Empleado -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID"
                android:textSize="10sp"
                android:textColor="@color/black"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/tvIdEmpleado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M-001"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/verde_primario_oscuro" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>